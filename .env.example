# Copy to `.env` and fill in. `.env` is gitignored; this file is not.

# Postgres. Locally, any database you can create; on Vercel, the connection
# string of the attached Postgres (Neon, Supabase…).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio"

# Signs the session cookies. Generate a different one for production with
# `openssl rand -base64 32` — leaking it lets anyone forge a session.
BETTER_AUTH_SECRET=""
# The origin the app is served from. In production set it to your real domain.
BETTER_AUTH_URL="http://localhost:3000"

# Vercel Blob, for the portrait, project covers and certificate photos. Only
# the admin's uploads need it; the public site renders without it.
BLOB_READ_WRITE_TOKEN=""

# Optional. The public origin used for the sitemap, robots.txt and Open Graph
# URLs. On Vercel it falls back to the production domain; locally, to
# http://localhost:3000. See `lib/site.ts`.
# NEXT_PUBLIC_SITE_URL="https://example.com"
