// Prisma schema. The connection URL lives in `prisma.config.ts`, which reads it
// from `.env` — see https://pris.ly/prisma-config-env-vars.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Site-wide profile settings, edited from `/admin`. The site has a single
/// owner, so this table holds exactly one row and `id` is pinned to a constant
/// instead of being generated — that is what lets the admin `upsert` it without
/// first having to look up which row to write.
model Profile {
  id String @id @default("main")

  /// Absolute URL of the portrait in Vercel Blob. Null until one is uploaded,
  /// which is why `Location` still has to render its placeholder.
  imageUrl  String?
  updatedAt DateTime @updatedAt
}

/// A link to somewhere else — email, GitHub, LinkedIn, a CV, anything.
///
/// One generic table rather than a column per network: the admin offers the
/// usual ones as presets, but adding a new place to be found is then a row
/// rather than a migration.
model ContactLink {
  id String @id @default(uuid())

  /// Picks the icon in `app/components/Contact.tsx`. Free-form on purpose —
  /// anything the component does not recognise falls back to a generic mark.
  platform String
  /// What the link says, and what a screen reader announces.
  label String
  /// Stored ready to use: `mailto:` for email, `https://` for the rest.
  url String
  /// Ascending. Ties are broken by `createdAt` so the order is never arbitrary.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([position, createdAt])
}

/// One thing worth listing under Skills, rendered by
/// `app/components/Skills.tsx`.
///
/// `category` is a free-form string rather than an enum: the groupings on a
/// portfolio shift as the work does, and a new heading should be something you
/// type into the admin, not a migration.
model Skill {
  id String @id @default(uuid())

  name     String
  /// Groups the tags on the public site, e.g. "CMS" or "Backend".
  category String
  /// Ascending, within the category. Ties broken by `createdAt`.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([position, createdAt])
}

/// A portfolio project, rendered by `app/components/Projects.tsx`.
model Project {
  id           String   @id @default(uuid())
  title        String
  /// The CMS or stack the project is built on, e.g. "Drupal".
  type         String
  description  String
  technologies String[]
  /// Cover image in Vercel Blob. Null when none was uploaded, which is why the
  /// card has to hold its own without one.
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// The four models below back Better Auth and are generated by
// `npx @better-auth/cli generate`. Re-run it after changing `lib/auth.ts`
// rather than editing them by hand.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
